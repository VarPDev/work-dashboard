# Jira Cloud instance, full URL, no trailing slash
JIRA_BASE_URL=https://your-domain.atlassian.net

# Atlassian account email (the "username" half of Basic auth)
JIRA_EMAIL=you@example.com

# Jira Cloud API token, created at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=ATATT3xFfGF0_fake_token_value_replace_me

# basic  -> Jira Cloud, Authorization: Basic base64(email:token)   <-- this instance
# bearer -> Jira Data Center/Server PAT, Authorization: Bearer <token>
JIRA_AUTH_MODE=basic

# accountId whose workload the dashboard shows by default. Required, because on
# this instance the token belongs to a shared service account, not to a person.
# Find it with: pnpm probe "your.name@example.com"
JIRA_DEFAULT_ACCOUNT_ID=712020:00000000-0000-0000-0000-000000000000
